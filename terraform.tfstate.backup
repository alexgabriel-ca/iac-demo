            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AWSConfigBucketPermissionsCheck\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetBucketAcl\",\n      \"Resource\": \"arn:aws:s3:::awsconfigrecorderbucket\"\n    },\n    {\n      \"Sid\": \"AWSConfigBucketExistenceCheck\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::awsconfigrecorderbucket\"\n    },\n    {\n      \"Sid\": \"AWSConfigBucketDelivery\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::awsconfigrecorderbucket/config/AWSLogs/674624010943/Config/*\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:x-amz-acl\": \"bucket-owner-full-control\"\n        }\n      }\n    }\n  ]\n}",
            "override_policy_documents": null,
